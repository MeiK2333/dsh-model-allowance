{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": [
    "types/**/*.d.ts",
    "index.js",
    "lib/**/*.js",
    "src/client/format.js",
    "src/client/windows.js",
    "src/client/schedule.js",
    "src/client/locales.js"
  ],
  "exclude": ["node_modules"]
}
