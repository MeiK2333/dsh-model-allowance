{
  "name": "dsh-model-allowance",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Shows the current conversation model's provider balance or remaining allowance in the composer.",
  "license": "MIT",
  "author": "MeiK2333",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MeiK2333/dsh-model-allowance.git"
  },
  "homepage": "https://github.com/MeiK2333/dsh-model-allowance#readme",
  "bugs": {
    "url": "https://github.com/MeiK2333/dsh-model-allowance/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "balance",
    "quota",
    "allowance",
    "composer"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/*.js",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  }
}
